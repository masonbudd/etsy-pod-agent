# Copy to .env and fill in. .env is gitignored.

# Etsy developer app (https://www.etsy.com/developers/your-apps)
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
# Must match a callback URL registered on your Etsy app
ETSY_REDIRECT_URI=http://localhost:3456/callback

# OpenAI, only for generated designs and room templates (phase 2)
OPENAI_API_KEY=

# Print provider API key (only for the API adapter)
PRINT_PROVIDER_API_KEY=

# Optional: full path to realesrgan-ncnn-vulkan(.exe) if it is not on PATH
REALESRGAN_PATH=
